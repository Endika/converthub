{
  "name": "ConvertHub - Professional Currency & Unit Converter",
  "short_name": "ConvertHub",
  "description": "Convert currencies, units, and sizes offline. No ads, multi-language support, open source.",
  "version": "1.0.0",
  "manifest_version": 3,

  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#6366f1",
  "background_color": "#0f172a",

  "icons": [
    {
      "src": "/icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],

  "categories": ["productivity", "travel", "utilities"],

  "screenshots": [
    {
      "src": "/screenshots/desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/screenshots/mobile.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ],

  "shortcuts": [
    {
      "name": "Convert Money",
      "short_name": "Money",
      "description": "Quick access to currency converter",
      "url": "/?tab=currencies",
      "icons": [
        {
          "src": "/icons/shortcut-money.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Convert Units",
      "short_name": "Units",
      "description": "Quick access to unit converter",
      "url": "/?tab=distance",
      "icons": [
        {
          "src": "/icons/shortcut-units.png",
          "sizes": "192x192"
        }
      ]
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "text/plain": [".txt"],
        "text/csv": [".csv"]
      }
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "web+converthub",
      "url": "/?convert=%s"
    }
  ],

  "note": "ConvertHub - Open source professional PWA built with TypeScript, DDD, and Clean Code principles. MIT License.",
  "author": "ConvertHub Contributors",
  "homepage_url": "https://converthub.io",
  "documentation_url": "https://github.com/usuario/converthub",
  "feedback_url": "https://github.com/usuario/converthub/issues",
  "license": "MIT"
}
